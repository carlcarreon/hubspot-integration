# Local Docker Compose PostgreSQL connection. URL-encode special characters.
DATABASE_URL=postgresql://hubspot:hubspot@localhost:5432/hubspot_order_sync?schema=public

NODE_ENV=development
API_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Required when Phase 2 webhook delivery is implemented.
WEBHOOK_SIGNING_SECRET=replace-with-a-long-random-secret

# Required to access the monitoring dashboard API. This is not a HubSpot token.
# Vite reads it server-side for the local /api proxy; do not use a VITE_ prefix.
# Use a distinct, high-entropy value and do not expose it in a deployed browser app.
DASHBOARD_API_TOKEN=replace-with-a-separate-dashboard-access-token

# Required by `npm run worker`. Keep real values only in your uncommitted .env.
HUBSPOT_ACCESS_TOKEN=replace-with-a-private-app-token
HUBSPOT_PIPELINE_ID=replace-with-a-pipeline-internal-id
HUBSPOT_DEAL_STAGE_ID=replace-with-a-deal-stage-internal-id

# Durable worker settings. The worker is a separate process from the API.
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=300
# Maximum total processing attempts, including the first attempt. Retry delays
# use capped exponential backoff with jitter; Retry-After is capped at max delay.
WORKER_MAX_ATTEMPTS=8
WORKER_RETRY_BASE_DELAY_MS=1000
WORKER_RETRY_MAX_DELAY_MS=60000
