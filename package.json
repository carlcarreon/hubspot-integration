{
  "name": "hubspot-order-sync",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev --workspace @hubspot-order-sync/backend\" \"npm run dev --workspace @hubspot-order-sync/frontend\"",
    "dev:backend": "npm run dev --workspace @hubspot-order-sync/backend",
    "dev:frontend": "npm run dev --workspace @hubspot-order-sync/frontend",
    "worker": "npm run worker --workspace @hubspot-order-sync/backend",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "test:phase4:verify": "npm run test:phase4:verify --workspace @hubspot-order-sync/backend",
    "db:generate": "npm run db:generate --workspace @hubspot-order-sync/backend",
    "db:migrate:dev": "npm run db:migrate:dev --workspace @hubspot-order-sync/backend",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @hubspot-order-sync/backend",
    "db:studio": "npm run db:studio --workspace @hubspot-order-sync/backend",
    "webhook:send": "node --env-file=.env --import tsx scripts/send_webhook.ts"
  },
  "devDependencies": {
    "concurrently": "10.0.6"
  }
}
