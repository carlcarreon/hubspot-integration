        "jsCode": "const { timingSafeEqual } = require('crypto');\n\nconst headerValue = $json.headers?.['x-webhook-signature'] ?? $json.headers?.['X-Webhook-Signature'];\nconst match = typeof headerValue === 'string' ? /^sha256=([a-f0-9]{64})$/i.exec(headerValue) : null;\nconst computed = typeof $json.computedHmac === 'string' ? $json.computedHmac : '';\n\nlet signatureValid = false;\nif (match && /^[a-f0-9]{64}$/i.test(computed)) {\n  const supplied = Buffer.from(match[1], 'hex');\n  const expected = Buffer.from(computed, 'hex');\n  signatureValid = supplied.length === expected.length && timingSafeEqual(supplied, expected);\n}\n\nreturn { json: { ...$json, signatureValid } };"
